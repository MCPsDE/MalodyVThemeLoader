<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <AssemblyName>MalodyVBepInExInstaller</AssemblyName>
    <RootNamespace>MalodyVBepInExInstaller</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
    <InformationalVersion>1.0.0</InformationalVersion>
    <ApplicationIcon>..\MalodyVThemeLoader.Windows\Assets\mtp.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\MalodyVThemeLoader.Windows\MalodyVThemeLoader.Windows.csproj" />
    <ProjectReference Include="..\MalodyVThemeLoader.Shared\MalodyVThemeLoader.Shared.csproj" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\..\artifacts\malody-bepinex-payload.zip')">
    <EmbeddedResource Include="..\..\artifacts\malody-bepinex-payload.zip"
                      LogicalName="MalodyVBepInExInstaller.Payload.zip" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\..\artifacts\downloads\BepInEx.ConfigurationManager_IL2CPP_v19.0.zip')">
    <EmbeddedResource Include="..\..\artifacts\downloads\BepInEx.ConfigurationManager_IL2CPP_v19.0.zip"
                      LogicalName="MalodyVBepInExInstaller.ConfigurationManager.zip" />
  </ItemGroup>
</Project>
